# Copy this file to .env.local and fill in values from
# Supabase dashboard -> Project Settings -> API Keys.
# Leave these blank to run in demo mode with built-in fake data.
NEXT_PUBLIC_SUPABASE_URL=https://gqimoqbracyrivotzvav.supabase.co
# The "publishable" key (sb_publishable_...) or the legacy "anon" key.
# Both are safe in the browser because Row Level Security protects the data.
# NEVER put the "secret" / "service_role" key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
